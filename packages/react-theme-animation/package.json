{
  "name": "@space-man/react-theme-animation",
  "version": "2.3.0",
  "description": "React theme switching with smooth view transition animations and multi-theme support",
  "keywords": [
    "animation",
    "dark",
    "dark mode",
    "hooks",
    "light",
    "light mode",
    "nextjs",
    "react",
    "reactjs",
    "shadcn",
    "switch",
    "tailwind",
    "tailwindcss",
    "theme",
    "theme switching",
    "typescript",
    "view transitions",
    "view-transition",
    "view-transition-api",
    "vite"
  ],
  "homepage": "https://github.com/tonyedgal/spaceman-react-theme-animation#readme",
  "bugs": {
    "url": "https://github.com/tonyedgal/spaceman-react-theme-animation/issues"
  },
  "license": "MIT",
  "author": "tonyedgal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyedgal/spaceman-react-theme-animation.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./tanstack": {
      "import": {
        "types": "./dist/tanstack/index.d.ts",
        "default": "./dist/tanstack/index.js"
      },
      "require": {
        "types": "./dist/tanstack/index.d.cts",
        "default": "./dist/tanstack/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup && node scripts/mark-react-client.mjs",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "test": "node scripts/smoke-subpath-imports.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "motion": "^12.27.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "@radix-ui/react-select": ">=2",
    "motion": ">=11",
    "react": ">=17",
    "react-dom": ">=17"
  }
}
