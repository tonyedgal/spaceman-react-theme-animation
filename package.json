{
  "name": "spaceman-rta-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "changeset:breaking": "changeset add --type major",
    "changeset:feature": "changeset add --type minor",
    "changeset:patch": "changeset add --type patch",
    "changeset:publish": "pnpm build && changeset publish",
    "changeset:version": "changeset version",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "format": "oxfmt --check .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "quality": "turbo run lint format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@oxlint/plugins": "1.86.0",
    "antislop-plugin": "0.1.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsup": "^8.5.1",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.18.3"
}
