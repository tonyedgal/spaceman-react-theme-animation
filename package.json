{
  "name": "spaceman-rta-workspace",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write . --config ./.prettierrc",
    "format:check": "prettier --check . --config ./.prettierrc",
    "clean": "turbo clean",
    "changeset": "changeset",
    "changeset:patch": "changeset add --type patch",
    "changeset:feature": "changeset add --type minor",
    "changeset:breaking": "changeset add --type major",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.18.3"
}
